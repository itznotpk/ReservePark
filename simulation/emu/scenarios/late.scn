# Arrive at 30 min: one LATE message, no fee  [D02]
WAITUNTIL 10
BOOK A1
WAITUNTIL 1000
EXPECT n_LATE=1 n_NOSHOW_FEE=0 owner=1
WAITUNTIL 1810
CAMERA entry A1
WAITC 80
EXPECT grant_entry=1 display=GO_BAY n_LATE=1
PASS entry
WAIT 1
BAY 0 OCC
WAIT 20
EXPECT n_LATE=1 n_NOSHOW_FEE=0 inside=1
CAMERA exit A1
WAITC 80
BAY 0 VAC
PASS exit
WAIT 2
EXPECT n_DURATION=1 n_NOSHOW_FEE=0 n_LATE=1 owner=0
